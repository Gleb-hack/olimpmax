# Copy to .env: cp .env.example .env — used by `docker compose` and by `pnpm dev`.
# No working tokens, keys or passwords here: put your own values into .env (it is not committed).

# PostgreSQL. The password is for the local database only; `pnpm dev` connects to it on 127.0.0.1:55432.
POSTGRES_PASSWORD=olimp-local-dev-only
DATABASE_URL=postgresql://olimp:olimp-local-dev-only@127.0.0.1:55432/olimp

# Required. At least 32 characters, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Token of the MAX bot that opens the Mini App: sign-in inside MAX, bot commands and reminders. Server only.
# Empty: the Docker stack still starts, the bot stays off and sign-in works through TEST_ACCOUNTS.
# MAX gives each update to one polling client only: do not use the token of a bot already running on a server.
MAX_BOT_TOKEN=

# Test accounts for signing in outside MAX (browser, API checks): login:password pairs separated by commas,
# password at least 8 characters, e.g. student:your-own-password. Empty: sign-in by password is off.
TEST_ACCOUNTS=

# Optional: the «Олимп» assistant chat. Server only, never in VITE_* variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Port of the Mini App in `docker compose` (http://localhost:8080).
WEB_PORT=8080

# Reminders go out between these hours of the pupil's local time (region of the profile, Moscow when unknown);
# the bot checks every BOT_CHECK_MINUTES. BOT_REMIND_ESTIMATED=true also reminds about season-derived dates.
BOT_REMINDER_HOUR=16
BOT_REMINDER_UNTIL_HOUR=21
BOT_CHECK_MINUTES=15
BOT_REMIND_ESTIMATED=true

# Only for `pnpm dev` (Docker sets its own values).
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# One local demo account without MAX; allowed only in development on a loopback address.
ALLOW_DEV_AUTH=false
