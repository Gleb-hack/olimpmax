DATABASE_URL=postgresql://olimp:olimp-local-dev-only@127.0.0.1:55432/olimp
POSTGRES_PASSWORD=olimp-local-dev-only
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Generate your own secret (at least 32 characters). Never use VITE_* for secrets.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
MAX_BOT_TOKEN=
# Enables a single local demo account; forbidden in production and on public hosts.
ALLOW_DEV_AUTH=false
# Server only. Never put this key in VITE_* variables or client code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# MAX bot (pnpm dev:bot). Uses MAX_BOT_TOKEN above. Do not run it locally with the production
# bot token while the server bot is running: MAX gives each update to only one polling client.
# Reminders go out between these Moscow hours; the bot checks every BOT_CHECK_MINUTES.
BOT_REMINDER_HOUR=10
BOT_REMINDER_UNTIL_HOUR=21
BOT_CHECK_MINUTES=15
# true: also remind about catalog dates whose year is taken from the season (marked in the message).
BOT_REMIND_ESTIMATED=true
