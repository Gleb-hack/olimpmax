{
  "name": "olimp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --import tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:web": "pnpm --filter @olimp/web dev",
    "dev:bot": "node --watch --import tsx --env-file-if-exists=.env apps/bot/src/main.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "pnpm build:api && pnpm build:bot",
    "build:api": "esbuild apps/api/src/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=apps/api/dist/server.js",
    "build:bot": "esbuild apps/bot/src/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=apps/bot/dist/main.js",
    "build:web": "pnpm --filter @olimp/web exec vite build",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "start:bot": "node --env-file-if-exists=.env apps/bot/dist/main.js",
    "bot:remind": "node --import tsx --env-file-if-exists=.env apps/bot/src/remind-once.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @olimp/web typecheck",
    "test": "node --import tsx --test tests/*.test.ts && pnpm --filter @olimp/web test",
    "test:integration": "node --import tsx --env-file-if-exists=.env --test tests/*.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx --env-file-if-exists=.env apps/api/src/scripts/migrate.ts",
    "db:import": "node --import tsx --env-file-if-exists=.env apps/api/src/scripts/import.ts",
    "db:audit": "node --import tsx apps/api/src/scripts/audit.ts",
    "db:stages": "node --import tsx --env-file-if-exists=.env apps/api/src/scripts/stages.ts",
    "db:verified": "node --import tsx --env-file-if-exists=.env apps/api/src/scripts/stages.ts data/verified/stages-2026-27.json",
    "db:setup": "pnpm db:migrate && pnpm db:import && pnpm db:verified",
    "db:reference": "node --import tsx --env-file-if-exists=.env apps/api/src/scripts/reference.ts",
    "data:check": "node --import tsx apps/api/src/scripts/check-reference.ts",
    "openapi": "node --import tsx apps/api/src/scripts/openapi.ts",
    "data-api:check": "node scripts/check-data-api.mjs",
    "db:local": "node --env-file-if-exists=.env scripts/local-db.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm data:check && pnpm openapi --check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "2.9.1"
  }
}
