# SITE_ADDRESS: ":80" for a local run over HTTP, the domain in production (Caddy obtains the certificate).
{$SITE_ADDRESS} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	handle_path /api/* {
		reverse_proxy api:3001
	}
	handle {
		root * /srv/olimp
		try_files {path} /index.html
		file_server
	}
}
