<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Олимпиады</title>
    <script src="https://st.max.ru/js/max-web-app.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f5f5f5;
            color: #1a1a1a;
            height: 100vh;
            overflow: hidden;
        }

        .app-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            position: relative;
        }

        .tab-content {
            display: none;
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            padding-bottom: 80px;
        }

        .tab-content.active {
            display: block;
        }

        .tab-content h2 {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 16px;
            color: #1a1a1a;
        }

        .olympiad-card {
            background: #fff;
            border-radius: 12px;
            padding: 14px 16px;
            margin-bottom: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            cursor: pointer;
            transition: transform 0.15s;
        }

        .olympiad-card:active {
            transform: scale(0.98);
        }

        .olympiad-card .title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #1a1a1a;
        }

        .olympiad-card .meta {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: #888;
        }

        .olympiad-card .deadline {
            color: #e53935;
            font-weight: 500;
        }

        .tabbar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            display: flex;
            background: #fff;
            border-top: 1px solid #e8e8e8;
            padding: 6px 0;
            padding-bottom: max(6px, env(safe-area-inset-bottom));
            z-index: 100;
        }

        .tab-btn {
            flex: 1;
            background: none;
            border: none;
            padding: 8px 4px;
            font-size: 12px;
            font-weight: 500;
            color: #999;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            transition: color 0.2s;
        }

        .tab-btn .icon {
            font-size: 20px;
            line-height: 1;
        }

        .tab-btn.active {
            color: #2688eb;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 12px;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="app-container">

        <div id="content-catalog" class="tab-content active">
            <h2>Каталог олимпиад</h2>
            <div id="olympiad-list">
                <div class="olympiad-card">
                    <div class="title">Всероссийская олимпиада школьников</div>
                    <div class="meta">
                        <span>Математика, 8-11 класс</span>
                        <span class="deadline">до 15 апреля</span>
                    </div>
                </div>
                <div class="olympiad-card">
                    <div class="title">Олимпиада «Высшая проба»</div>
                    <div class="meta">
                        <span>Информатика, 9-11 класс</span>
                        <span class="deadline">до 1 мая</span>
                    </div>
                </div>
                <div class="olympiad-card">
                    <div class="title">Олимпиада «Физтех»</div>
                    <div class="meta">
                        <span>Физика, 9-11 класс</span>
                        <span class="deadline">до 20 апреля</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="content-plan" class="tab-content">
            <h2>Мой план</h2>
            <div class="empty-state">
                <div class="icon">📋</div>
                <p>Здесь появятся ваши сохранённые олимпиады</p>
            </div>
        </div>

        <div id="content-profile" class="tab-content">
            <h2>Профиль</h2>
            <div class="empty-state">
                <div class="icon">👤</div>
                <p>Интересы и класс можно будет настроить здесь</p>
            </div>
        </div>

        <nav class="tabbar">
            <button class="tab-btn active" data-tab="catalog">
                <span class="icon">📚</span>
                <span>Каталог</span>
            </button>
            <button class="tab-btn" data-tab="plan">
                <span class="icon">📋</span>
                <span>План</span>
            </button>
            <button class="tab-btn" data-tab="profile">
                <span class="icon">👤</span>
                <span>Профиль</span>
            </button>
        </nav>
    </div>

    <script>
        if (window.WebApp) {
            WebApp.ready();
        }

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                btn.classList.add('active');
                document.getElementById('content-' + btn.dataset.tab).classList.add('active');
            });
        });

        if (window.WebApp && WebApp.initDataUnsafe) {
            const user = WebApp.initDataUnsafe.user;
            if (user) {
                console.log('Пользователь:', user.first_name);
            }
        }
    </script>
</body>
</html>
