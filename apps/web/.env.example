# Empty uses /api; Vite proxies it to port 3001 during development.
VITE_API_URL=
# Explicit isolated fixture mode. Leave as api to use PostgreSQL through the API.
VITE_DATA_MODE=api
# Only used by the development server outside MAX; requires ALLOW_DEV_AUTH=true in the API.
VITE_DEV_AUTH=true
# Optional support URL. DeepSeek is configured ONLY in the server's root .env.
VITE_SUPPORT_URL=
