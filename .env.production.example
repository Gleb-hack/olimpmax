# Domain only: no https:// prefix and no trailing slash.
APP_DOMAIN=olimp.example.com
# Generate each separately with: openssl rand -hex 32
# Use hexadecimal values so the database URL does not need URL escaping.
POSTGRES_PASSWORD=
JWT_SECRET=
# Token of the SAME bot that opens this Mini App. Server only.
MAX_BOT_TOKEN=
# Optional: test accounts for reviewers outside MAX (login:password pairs separated by commas, passwords of 8+ characters).
# Give the passwords to reviewers privately; empty switches the sign-in by password off.
TEST_ACCOUNTS=
# Optional: required only for the assistant (its web lookups need no extra key).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# MAX bot reminders: hours of the daily mailing by the pupil's local time (region of the profile,
# Moscow when unknown) and whether catalog dates
# with a season-derived year are included (they are marked in the message).
BOT_REMINDER_HOUR=16
BOT_REMINDER_UNTIL_HOUR=21
BOT_CHECK_MINUTES=15
BOT_REMIND_ESTIMATED=true
